---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// TAGLINE OPTIONS — currently using #1. Swap the active line below to try others.
// 1. "Listen to the land. Live close to it. Experience what we forgot we needed."
// 2. "A place to listen — to the land, to your kids, to yourself."
// 3. "Slow down. Eat from the soil. Sit with elders. Remember."
const tagline = "Listen to the land. Live close to it. Experience what we forgot we needed.";

const pillars = [
  {
    title: 'Bring your family',
    subtitle: 'Roots for your kids. A pause for you.',
    body: "Grandparents teach. Grandchildren question. You exhale. If you live abroad — this is the India visit that actually roots your kids in something real.",
  },
  {
    title: 'Get your hands in soil',
    subtitle: 'Grow food. Build with mud. Plant trees.',
    body: "Walk a food forest. Build a wall from stone, lime, jaggery. Plant a tree with your kid. Not a workshop — actual work, on actual land.",
  },
  {
    title: 'Reset your body',
    subtitle: 'Sun, mud, silence, sleep.',
    body: "Wake with the sun. Eat from the farm. Sit in silence. If you're carrying a lifestyle disorder, this is a slower, deeper way back — not a detox package.",
  },
  {
    title: 'Sit with elders',
    subtitle: 'Wisdom that was never meant to be sold back.',
    body: "Crafts. Stories. Indic practices. Things your grandparents knew and you didn't get to learn. Pick one. Take it home.",
  },
  {
    title: 'Bring your team',
    subtitle: 'Retreats for unlearning.',
    body: "For founders, leaders, teams ready to sit with hard questions. The land is the facilitator. You leave clearer than you came.",
  },
  {
    title: 'Give your years forward',
    subtitle: 'For elders with something to pass on.',
    body: "If you've gathered a lifetime of skill and want to gift it forward — to kids, to community, to the land — come build a program with us.",
  },
];

const foundingTier = {
  headline: '~200 bed-nights, valid 5 years',
  detail: "That's roughly 4 weeks a year for 5 years — yours and your family's.",
  extras: [
    'Guest passes — bring your parents, your siblings, your closest friends',
    'First access to seasonal immersions and events',
    'A say in what we build and how — your voice helps shape this place',
    'Your name on the Founding Wall, always',
  ],
};

const lifetimeTier = {
  headline: '~400 bed-nights, no expiry',
  detail: 'Twice the stays. No clock. Yours for life.',
  extras: [
    'Everything in the Founding Member tier',
    'Priority for longer stays and family gatherings',
    'A closer seat at the table as we grow',
    'First access to new spaces as they open',
  ],
};

const seatsJoined = 8;
const seatsRemaining = 92;
const seatsTotal = 100;

const galleryPhotos = [
  { src: '/images/community-gathering.jpg', caption: 'Sunday listening circles' },
  { src: '/images/activities-collage.jpg', caption: "Children's deep-roots summer camps" },
  { src: '/images/community-group.jpg', caption: 'Service space retreats' },
  { src: '/images/food-forest.jpg', caption: 'Plantation drives, every season' },
  { src: '/images/campus-overview.png', caption: 'Residential campus — opens end of 2026' },
  { src: '/images/campus-peacock.png', caption: 'The land, ten years in' },
];
---

<BaseLayout
  title="Founding Circle | Asmakam"
  description="15 acres near Indore. A place we are building together. 100 founding seats for families ready to come home — for stays, for kids, for elders, for yourself."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative py-20 md:py-28 overflow-hidden bg-cream">
      <div class="absolute inset-0">
        <img
          src="/images/founding-circle/aerial-view.webp"
          alt="Aerial view of Asmakam's 15 acres near Indore"
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-forest/80 via-forest/60 to-forest/85"></div>
      </div>
      <div class="container-narrow mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <img
          src="/images/logo.png"
          alt="Asmakam"
          class="h-20 md:h-24 mx-auto mb-6 animate-fade-in-up drop-shadow-lg"
          loading="eager"
        />
        <h1 class="font-heading text-5xl md:text-7xl text-white font-bold mb-5 animate-fade-in-up delay-100 drop-shadow-lg">
          अस्माकम्
        </h1>
        <p class="font-heading italic text-xl md:text-2xl text-sand mb-3 animate-fade-in-up delay-200 max-w-2xl mx-auto">
          {tagline}
        </p>
        <p class="font-body text-base md:text-lg text-green-100/90 mb-8 animate-fade-in-up delay-300">
          The deepest things aren't taught. They're shared.
        </p>
        <div class="inline-flex flex-wrap justify-center items-center gap-x-4 gap-y-2 px-6 py-3 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 font-body text-sm md:text-base text-white animate-fade-in-up delay-300">
          <span>Ecological Living</span>
          <span class="text-gold">·</span>
          <span>Holistic Wellbeing</span>
          <span class="text-gold">·</span>
          <span>Life Skills</span>
        </div>
      </div>
    </section>

    <!-- The Space -->
    <section class="section-padding bg-cream">
      <div class="container-narrow mx-auto">
        <div class="text-center mb-12">
          <h2 class="section-title">The Space</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-10 items-start mb-16">
          <div class="space-y-5 font-body text-text-muted leading-relaxed text-lg">
            <p>
              A place we are building together. Rooted in one simple intent — to put us back in
              relationship with nature, with each other, with ourselves.
            </p>
            <p>
              It started as one family's question:
              <em>what happens when you stop outsourcing your life?</em>
            </p>
            <p>
              Ten years in, we're still asking. We grow a biodiverse food forest. We harvest rain.
              We build with stone, lime, urad daal, methi, jaggery, gond. We learn from the land
              as it teaches us.
            </p>
            <p>
              Now we're opening it up. To you.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <img
              src="/images/founding-circle/natural-building.webp"
              alt="Dome construction using traditional building techniques"
              class="w-full h-56 md:h-64 object-cover rounded-sm shadow-lg"
              loading="lazy"
            />
            <img
              src="/images/founding-circle/sanctuary-render.webp"
              alt="Asmakam sanctuary building render"
              class="w-full h-56 md:h-64 object-cover rounded-sm shadow-lg"
              loading="lazy"
            />
          </div>
        </div>

        <div class="max-w-2xl mx-auto text-center">
          <p class="font-heading italic text-xl md:text-2xl text-forest mb-2">
            अस्माकम् means "ours." Not mine. Not yours.
          </p>
          <p class="font-body text-text-muted">
            What's growing here belongs to all who tend it.
          </p>
        </div>
      </div>
    </section>

    <!-- Ways to come home -->
    <section class="section-padding bg-white">
      <div class="container-wide mx-auto">
        <div class="text-center mb-12">
          <h2 class="section-title">Ways to come home</h2>
          <p class="section-subtitle mx-auto">Six reasons people show up. Pick yours — or come for all of them.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pillars.map((pillar) => (
            <div class="card p-8 bg-gradient-to-b from-cream to-sand">
              <h3 class="font-heading text-2xl text-forest font-semibold mb-2">{pillar.title}</h3>
              <p class="font-body text-sm uppercase tracking-wide text-leaf font-medium mb-4">
                {pillar.subtitle}
              </p>
              <p class="font-body text-text-muted leading-relaxed">{pillar.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Founding Circle Tiers -->
    <section class="section-padding bg-sand">
      <div class="container-narrow mx-auto">
        <div class="text-center mb-12">
          <h2 class="section-title">Join the Founding Circle</h2>
          <p class="font-heading italic text-xl text-leaf mb-4">{seatsTotal} seats. That's it.</p>
          <p class="section-subtitle mx-auto">
            Before this opens to everyone, a few people get to help shape it. Come early. Help us
            build it right.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Founding Member -->
          <div class="card p-8 md:p-10 bg-white">
            <h3 class="font-heading text-2xl text-forest font-semibold mb-2">Founding Member</h3>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-heading text-5xl text-saffron font-bold">$5,000</span>
            </div>
            <p class="font-body text-sm text-text-muted mb-6">One-time. Yours for 5 years.</p>

            <div class="rounded-lg bg-cream p-5 mb-6 border-l-4 border-saffron">
              <p class="font-heading text-2xl text-forest font-bold mb-1">
                {foundingTier.headline}
              </p>
              <p class="font-body text-sm text-text-muted">{foundingTier.detail}</p>
            </div>

            <p class="font-body text-sm uppercase tracking-wide text-leaf font-medium mb-3">
              Plus
            </p>
            <ul class="space-y-3">
              {foundingTier.extras.map((item) => (
                <li class="flex gap-3 font-body text-text-primary">
                  <span class="text-leaf flex-shrink-0 mt-1">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Lifetime Founding Member -->
          <div class="card p-8 md:p-10 bg-gradient-to-br from-forest to-leaf text-white relative overflow-hidden">
            <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-gold text-forest text-xs font-body font-semibold uppercase tracking-wide">
              Lifetime
            </div>
            <h3 class="font-heading text-2xl font-semibold mb-2">Lifetime Founding Member</h3>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-heading text-5xl text-gold font-bold">$10,000+</span>
            </div>
            <p class="font-body text-sm text-green-100 mb-6">One-time. Yours for life.</p>

            <div class="rounded-lg bg-white/10 backdrop-blur-sm p-5 mb-6 border-l-4 border-gold">
              <p class="font-heading text-2xl text-gold font-bold mb-1">
                {lifetimeTier.headline}
              </p>
              <p class="font-body text-sm text-green-50">{lifetimeTier.detail}</p>
            </div>

            <p class="font-body text-sm uppercase tracking-wide text-gold font-medium mb-3">
              Plus
            </p>
            <ul class="space-y-3">
              {lifetimeTier.extras.map((item) => (
                <li class="flex gap-3 font-body">
                  <span class="text-gold flex-shrink-0 mt-1">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <p class="font-body text-xs text-text-muted italic text-center max-w-2xl mx-auto mt-8">
          Every founding seat also sustains 200 native trees on the land — part of growing this
          15 acres into a 25,000-tree canopy.
        </p>

        <p class="font-body text-sm text-text-muted italic text-center max-w-2xl mx-auto mt-6">
          For Indian families and Indore locals, a local engagement pathway is in design — we'll
          share it once we're sure of what we can honour.
        </p>

        <div class="max-w-xl mx-auto mt-10">
          <div class="flex justify-between text-xs font-body text-text-muted mb-2">
            <span>{seatsJoined} of {seatsTotal} seats taken</span>
            <span>{seatsRemaining} remain</span>
          </div>
          <div class="w-full h-3 rounded-full bg-white overflow-hidden border border-sand">
            <div
              class="h-full bg-gradient-to-r from-saffron to-gold"
              style={`width: ${(seatsJoined / seatsTotal) * 100}%`}
            ></div>
          </div>
        </div>
      </div>
    </section>

    <!-- A decade of work, in pictures -->
    <section class="section-padding bg-cream">
      <div class="container-narrow mx-auto">
        <div class="text-center mb-12">
          <h2 class="section-title">A decade of work, in pictures</h2>
          <p class="section-subtitle mx-auto">
            Founded in 2014. Residential campus opens end of 2026.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {galleryPhotos.map((photo) => (
            <figure class="relative overflow-hidden rounded-sm shadow-lg group">
              <img
                src={photo.src}
                alt={photo.caption}
                class="w-full h-56 md:h-64 object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-forest/90 to-transparent p-4">
                <p class="font-body text-sm text-white">{photo.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding bg-white">
      <div class="container-narrow mx-auto">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="section-title mb-4">Plant your intention</h2>
          <p class="font-body text-lg text-text-muted mb-8">
            No payment now. Just a signal that this lands somewhere in you.
          </p>
          <a
            href="mailto:mgehlot@gmail.com?subject=Asmakam%20Founding%20Circle%20%E2%80%94%20Count%20me%20in"
            class="btn-primary text-lg"
          >
            I'm interested — count me in
          </a>
          <p class="font-body text-sm text-text-muted italic mt-6">
            No payment required. Your message goes straight to Manish — no one else sees it.
          </p>
        </div>
      </div>
    </section>

    <!-- Reach Manish -->
    <section class="section-padding bg-sand">
      <div class="container-narrow mx-auto">
        <div class="max-w-2xl mx-auto text-center">
          <p class="font-heading italic text-lg text-text-muted mb-8">
            The thread between you and the land — it didn't snap. It just thinned.
          </p>
          <h2 class="section-title mb-10">Reach Manish</h2>

          <div class="grid sm:grid-cols-3 gap-6 text-left sm:text-center mb-10">
            <div>
              <p class="font-body text-xs uppercase tracking-wide text-text-muted mb-1">US</p>
              <a href="tel:+19199729329" class="font-heading text-lg text-forest hover:text-leaf">
                +1 919 972 9329
              </a>
            </div>
            <div>
              <p class="font-body text-xs uppercase tracking-wide text-text-muted mb-1">
                India &amp; WhatsApp
              </p>
              <a href="tel:+917693867294" class="font-heading text-lg text-forest hover:text-leaf">
                +91 769 386 7294
              </a>
            </div>
            <div>
              <p class="font-body text-xs uppercase tracking-wide text-text-muted mb-1">Email</p>
              <a
                href="mailto:mgehlot@gmail.com"
                class="font-heading text-lg text-forest hover:text-leaf break-all"
              >
                mgehlot@gmail.com
              </a>
            </div>
          </div>

          <p class="font-body text-sm text-text-muted italic">
            100 founding seats · when they fill, this closes
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
